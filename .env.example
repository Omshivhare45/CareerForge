# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/careerforge

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# AI API (OpenAI or compatible)
AI_API_KEY=your_openai_api_key_here
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-3.5-turbo

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Admin seed credentials
ADMIN_EMAIL=admin@careerforge.com
ADMIN_PASSWORD=Admin@123

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Judge0 code execution (required for running/submitting code)
# Public CE instance (no key needed):
JUDGE0_API_URL=https://ce.judge0.com
# Judge0 CE with authentication (X-Auth-Token header):
# JUDGE0_AUTH_TOKEN=your_judge0_auth_token
# RapidAPI hosted Judge0 (uses X-RapidAPI-* headers instead):
# JUDGE0_API_KEY=your_rapidapi_key
# JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

